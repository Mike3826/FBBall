# Copy to .env.local (git-ignored).

# --- Fantrax transactions (`npm run fetch-transactions`) ---------------------
FANTRAX_LEAGUE_ID=r7yj6bpwmtswkp9p

# Your logged-in Fantrax cookies. Chrome DevTools -> Application -> Cookies ->
# https://www.fantrax.com, then join the fantrax.com cookies as "name=value; name=value".
FANTRAX_COOKIE=""

# Must match the browser the cf_clearance cookie was issued to (DevTools -> Network -> any
# request -> Request Headers -> User-Agent).
FANTRAX_USER_AGENT=""

# --- Discord ------------------------------------------------------------------
# Webhook for the Daily Rankings and Weekly Rankings "Publish to Discord" buttons.
# Discord: channel settings -> Integrations -> Webhooks -> New Webhook -> Copy Webhook URL.
DISCORD_WEBHOOK_URL=""
